{
  "name": "resend-mailbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && corepack pnpm --recursive --if-present test",
    "lint": "corepack pnpm --workspace-concurrency=1 --recursive --if-present lint",
    "typecheck": "corepack pnpm --workspace-concurrency=1 --recursive --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "node scripts/scan-secrets.mjs",
    "verify": "corepack pnpm security:scan && corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2"
  }
}
