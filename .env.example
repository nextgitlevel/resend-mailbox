# Local development only. Never commit real credentials.
NODE_ENV=development
API_PORT=3001
# Exact browser origin allowed to use authenticated cookie-based API requests.
CLIENT_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
POSTGRES_PASSWORD=CHANGE_ME
RESEND_MAILBOX_TEST_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://resend_mailbox_test:CHANGE_ME@127.0.0.1:15432/resend_mailbox_test
REDIS_URL=redis://127.0.0.1:16379/0
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=resend-mailbox
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Development only: 32 random bytes, base64url-encoded. Production requires a reviewed KMS provider.
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_VALUE
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BOOTSTRAP_TOKEN=CHANGE_ME_ONE_TIME_OWNER_BOOTSTRAP_TOKEN
